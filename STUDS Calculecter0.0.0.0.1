local function createCard(pos, size)
    local card = Instance.new("Frame")
    card.Position = pos
    card.Size = size
    card.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    card.BorderSizePixel = 1
    card.BorderColor3 = Color3.fromRGB(70, 70, 70)
    card.Parent = MainFrame
    return card
end

