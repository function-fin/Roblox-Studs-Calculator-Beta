local function getPlayerPosition()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        return character.HumanoidRootPart.Position
    end
    return nil
end

Btn1.MouseButton1Click:Connect(function()
    ponto1 = getPlayerPosition()
    ponto2 = nil
    LabelDistValue.Text = "0 STUDS"
end)

Btn2.MouseButton1Click:Connect(function()
    if ponto1 then
        ponto2 = getPlayerPosition()
        if ponto2 then
            local dist = (ponto2 - ponto1).Magnitude
            LabelDistValue.Text = string.format("%.1f STUDS", dist)
        end
    end
end)

BtnZerar.MouseButton1Click:Connect(function()
    ponto1 = nil
    ponto2 = nil
    LabelDistValue.Text = "0 STUDS"
end)

local function updateSwitchVisual()
    if modoTempoReal then
        SwitchKnob.Position = UDim2.new(1, -16, 0.5, -7)
        ToggleSwitch.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    else
        SwitchKnob.Position = UDim2.new(0, 2, 0.5, -7)
        ToggleSwitch.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

ToggleSwitch.MouseButton1Click:Connect(function()
    modoTempoReal = not modoTempoReal
    updateSwitchVisual()
end)

RunService.RenderStepped:Connect(function()
    if modoTempoReal and ponto1 and not ponto2 then
        local currentPos = getPlayerPosition()
        if currentPos then
            local dist = (currentPos - ponto1).Magnitude
            LabelDistValue.Text = string.format("%.1f STUDS", dist)
        end
    end
end)

